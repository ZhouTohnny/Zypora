<Window x:Class="Zypora.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zypora 更新"
        Width="470"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        Icon="app.ico"
        Background="{DynamicResource Br.WindowBg}"
        Foreground="{DynamicResource Br.Fg}">
    <Window.Resources>
        <SolidColorBrush x:Key="Br.WindowBg" Color="#F4F4F4"/>
        <SolidColorBrush x:Key="Br.PanelBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Br.PanelBorder" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="Br.Fg" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="Br.Muted" Color="#666666"/>
        <SolidColorBrush x:Key="Br.Hover" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="Br.Accent" Color="#CFE3FF"/>
        <SolidColorBrush x:Key="Br.AccentFg" Color="#1565C0"/>

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Br.Hover}"/>
            <Setter Property="Foreground" Value="{DynamicResource Br.Fg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Br.PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20,18">
        <StackPanel x:Name="PromptPanel">
            <TextBlock x:Name="HeadlineText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <Border x:Name="NotesBox" Margin="0,12,0,0" MaxHeight="220" CornerRadius="4" BorderThickness="1"
                    Background="{DynamicResource Br.PanelBg}" BorderBrush="{DynamicResource Br.PanelBorder}"
                    Padding="12,10" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="13" LineHeight="20"
                               Foreground="{DynamicResource Br.Fg}"/>
                </ScrollViewer>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="UpdateButton" Content="立即更新" Style="{StaticResource DialogButton}"
                        Background="{DynamicResource Br.Accent}" Foreground="{DynamicResource Br.AccentFg}"
                        IsDefault="True" Click="OnUpdate"/>
                <Button x:Name="LaterButton" Content="以后再说" Style="{StaticResource DialogButton}"
                        Margin="10,0,0,0" IsCancel="True" Click="OnLater"/>
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
            <TextBlock x:Name="StatusText" FontSize="15"/>
            <ProgressBar x:Name="Progress" Height="14" Margin="0,12,0,0" Minimum="0" Maximum="100"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelButton" Content="取消" Style="{StaticResource DialogButton}" Click="OnCancel"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
