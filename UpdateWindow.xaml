<Window x:Class="Zypora.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zypora 更新"
        Width="470"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        Icon="app.ico"
        Background="#FAFAFA"
        Foreground="#1E1E1E">
    <Grid Margin="20,18">
        <StackPanel x:Name="PromptPanel">
            <TextBlock x:Name="HeadlineText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="NotesText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#555555"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="UpdateButton" Content="立即更新" Padding="18,6" IsDefault="True" Click="OnUpdate"/>
                <Button x:Name="LaterButton" Content="以后再说" Padding="18,6" Margin="10,0,0,0" Click="OnLater"/>
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
            <TextBlock x:Name="StatusText" FontSize="15"/>
            <ProgressBar x:Name="Progress" Height="14" Margin="0,12,0,0" Minimum="0" Maximum="100"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelButton" Content="取消" Padding="18,6" Click="OnCancel"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
