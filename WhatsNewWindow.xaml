<Window x:Class="Zypora.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="更新完成"
        Width="500"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        Icon="app.ico"
        Background="{DynamicResource Br.WindowBg}"
        Foreground="{DynamicResource Br.Fg}">
    <Grid Margin="22,18">
        <StackPanel>
            <TextBlock x:Name="HeadlineText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <Border Margin="0,12,0,0" MaxHeight="340" CornerRadius="4" BorderThickness="1"
                    Background="{DynamicResource Br.PanelBg}" BorderBrush="{DynamicResource Br.PanelBorder}"
                    Padding="12,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="BodyText" TextWrapping="Wrap" FontSize="13" LineHeight="21"/>
                </ScrollViewer>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="知道了" IsDefault="True" IsCancel="True" Click="OnOk">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource Br.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Br.Fg}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Br.PanelBorder}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Padding" Value="16,6"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"
                                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
