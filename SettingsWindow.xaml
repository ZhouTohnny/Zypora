<Window x:Class="Zypora.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="390" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="app.ico" Background="#F4F4F4">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="背景图片" FontWeight="SemiBold" FontSize="14" Foreground="#333333"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="选择图片…" Padding="10,5" Click="OnChoose"/>
            <Button Content="清除背景" Padding="10,5" Margin="8,0,0,0" Click="OnClear"/>
            <TextBlock x:Name="ImageLabel" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#666666"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="透明度(越小越淡,文字越清晰)" FontWeight="SemiBold" FontSize="14" Margin="0,16,0,0" Foreground="#333333"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <Slider x:Name="OpacitySlider" Width="330" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="OnOpacityChanged"/>
            <TextBlock x:Name="OpacityLabel" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#666666"/>
        </StackPanel>

        <Border Grid.Row="4" Margin="0,12,0,0" BorderBrush="#DDDDDD" BorderThickness="1" Background="White">
            <Grid>
                <TextBlock x:Name="PreviewHint" Text="背景预览" Foreground="#BBBBBB"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image x:Name="PreviewImage" Stretch="UniformToFill"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" Width="84" Padding="10,5" Click="OnOk"/>
            <Button Content="取消" Width="84" Padding="10,5" Margin="8,0,0,0" Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>
