<Window x:Class="Zypora.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Zypora"
        mc:Ignorable="d"
        Title="Zypora - Markdown 编辑器" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen"
        Icon="app.ico"
        Background="{DynamicResource Br.WindowBg}"
        Foreground="{DynamicResource Br.Fg}">
    <Window.Resources>
        <SolidColorBrush x:Key="Br.WindowBg" Color="#F4F4F4"/>
        <SolidColorBrush x:Key="Br.PanelBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Br.FindBg" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="Br.PanelBorder" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="Br.Fg" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="Br.Muted" Color="#666666"/>
        <SolidColorBrush x:Key="Br.Hover" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="Br.Checked" Color="#CFE3FF"/>
        <SolidColorBrush x:Key="Br.CheckedFg" Color="#1565C0"/>

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Br.Hover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToolbarToggleButton" TargetType="ToggleButton">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Br.Hover}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Br.Checked}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Br.CheckedFg}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource Br.PanelBg}" BorderBrush="{DynamicResource Br.PanelBorder}" BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal" Margin="6,4">
                <Button x:Name="FileMenuButton" Style="{StaticResource ToolbarButton}" ToolTip="文件" Click="OnFileMenu">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="新建窗口" InputGestureText="Ctrl+N" Click="OnNewWindow"/>
                            <MenuItem Header="打开…" InputGestureText="Ctrl+O" Click="OnOpen"/>
                            <MenuItem Header="保存" InputGestureText="Ctrl+S" Click="OnSave"/>
                            <Separator/>
                            <MenuItem Header="导出 PDF…" Click="OnExportPdf"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Data="M 3,5 L 17,5 M 3,10 L 17,10 M 3,15 L 17,15"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
                <Separator Margin="6,0"/>
                <Button x:Name="FormatMenuButton" Content="格式 ▾" Style="{StaticResource ToolbarButton}" ToolTip="格式" Click="OnFormatMenu">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="一级标题" InputGestureText="Ctrl+1" Click="OnHeading1"/>
                            <MenuItem Header="二级标题" InputGestureText="Ctrl+2" Click="OnHeading2"/>
                            <Separator/>
                            <MenuItem Header="加粗" InputGestureText="Ctrl+B" Click="OnBold"/>
                            <MenuItem Header="斜体" InputGestureText="Ctrl+I" Click="OnItalic"/>
                            <Separator/>
                            <MenuItem Header="无序列表" InputGestureText="Ctrl+Shift+7" Click="OnList"/>
                            <MenuItem Header="有序列表" Click="OnOrderedList"/>
                            <MenuItem Header="引用" InputGestureText="Ctrl+Shift+O" Click="OnQuote"/>
                            <Separator/>
                            <MenuItem Header="行内代码" InputGestureText="Ctrl+K" Click="OnCode"/>
                            <MenuItem Header="代码块" InputGestureText="Ctrl+Shift+K" Click="OnCodeBlock"/>
                            <MenuItem Header="表格" InputGestureText="Ctrl+Shift+T" Click="OnInsertTable"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="ModeButton" Content="原生" Style="{StaticResource ToolbarButton}" Click="OnTogglePreview" ToolTip="切换 预览 / 原生 (Ctrl+/)"/>
                <Button Content="清空" Style="{StaticResource ToolbarButton}" Click="OnClear" ToolTip="清空当前文档 (Ctrl+Shift+N)"/>
                <Separator Margin="6,0"/>
                <ToggleButton x:Name="DarkButton" Padding="10,5" Style="{StaticResource ToolbarToggleButton}" Click="OnToggleDark" ToolTip="夜间模式(黑底白字)">
                    <Path Width="15" Height="15" Stretch="Uniform"
                          Data="M 7,9 A 5,5 0 1 1 17,9 A 5,5 0 1 1 7,9 Z M 9.5,14.4 L 9.5,17 M 14.5,14.4 L 14.5,17 M 10.5,19 L 13.5,19"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                          StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Fill="Transparent"/>
                </ToggleButton>
                <ToggleButton x:Name="TopmostButton" Padding="10,5" Style="{StaticResource ToolbarToggleButton}" Click="OnToggleTopmost" ToolTip="窗口置顶(总显示在最前)">
                    <Path Width="15" Height="15" Stretch="Uniform"
                          Data="M 10,2 L 14,2 L 14,4 L 13,5 L 17,11 L 18,11 L 18,13 L 6,13 L 6,11 L 7,11 L 11,5 L 10,4 Z M 12,13 L 12,21"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                          StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Fill="Transparent"/>
                </ToggleButton>
            </WrapPanel>
        </Border>

        <Border x:Name="FindBar" DockPanel.Dock="Top" Background="{DynamicResource Br.FindBg}" BorderBrush="{DynamicResource Br.PanelBorder}" BorderThickness="0,0,0,1" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Margin="6,4">
                <TextBox x:Name="FindBox" Width="200" VerticalContentAlignment="Center" Padding="4,3"
                         Background="{DynamicResource Br.PanelBg}" Foreground="{DynamicResource Br.Fg}"
                         TextChanged="OnFindTextChanged" KeyDown="OnFindKeyDown"/>
                <TextBox x:Name="ReplaceBox" Width="180" Margin="6,0,0,0" VerticalContentAlignment="Center" Padding="4,3"
                         Background="{DynamicResource Br.PanelBg}" Foreground="{DynamicResource Br.Fg}"
                         Visibility="Collapsed" KeyDown="OnReplaceKeyDown"/>
                <CheckBox x:Name="CaseBox" Content="Aa" Margin="8,0,0,0" VerticalAlignment="Center" Click="OnFindOptionChanged"/>
                <CheckBox x:Name="WholeWordBox" Content="全词" Margin="6,0,0,0" VerticalAlignment="Center" Click="OnFindOptionChanged"/>
                <CheckBox x:Name="RegexBox" Content=".*" Margin="6,0,0,0" VerticalAlignment="Center" Click="OnFindOptionChanged"/>
                <Button Content="上一个" Style="{StaticResource ToolbarButton}" Click="OnFindPrev"/>
                <Button Content="下一个" Style="{StaticResource ToolbarButton}" Click="OnFindNext"/>
                <Button x:Name="ReplaceButton" Content="替换" Style="{StaticResource ToolbarButton}" Visibility="Collapsed" Click="OnReplace"/>
                <Button x:Name="ReplaceAllButton" Content="全部替换" Style="{StaticResource ToolbarButton}" Visibility="Collapsed" Click="OnReplaceAll"/>
                <TextBlock x:Name="MatchLabel" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Br.Muted}"/>
                <Button Content="✕" Style="{StaticResource ToolbarButton}" Click="OnFindClose"/>
            </StackPanel>
        </Border>

        <Grid>
            <RichTextBox x:Name="Editor"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         FontFamily="Microsoft YaHei UI"
                         FontSize="16"
                         Padding="40,28"
                         BorderThickness="0"
                         TextChanged="OnTextChanged"/>

        </Grid>
    </DockPanel>
</Window>
