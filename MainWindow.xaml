<Window x:Class="Zypora.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Zypora"
        mc:Ignorable="d"
        Title="Zypora - Markdown 编辑器" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen"
        Icon="app.ico"
        Background="#F4F4F4">
    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToolbarToggleButton" TargetType="ToggleButton">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#CFE3FF"/>
                    <Setter Property="Foreground" Value="#1565C0"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal" Margin="6,4">
                <Button x:Name="FileMenuButton" Style="{StaticResource ToolbarButton}" ToolTip="文件" Click="OnFileMenu">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="新建窗口" InputGestureText="Ctrl+N" Click="OnNewWindow"/>
                            <MenuItem Header="打开…" InputGestureText="Ctrl+O" Click="OnOpen"/>
                            <MenuItem Header="保存" InputGestureText="Ctrl+S" Click="OnSave"/>
                            <Separator/>
                            <MenuItem Header="导出 PDF…" Click="OnExportPdf"/>
                            <Separator/>
                            <MenuItem Header="清空" InputGestureText="Ctrl+Shift+N" Click="OnClear"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Data="M 3,5 L 17,5 M 3,10 L 17,10 M 3,15 L 17,15"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
                <Separator Margin="6,0"/>
                <Button x:Name="ModeButton" Content="原生" Style="{StaticResource ToolbarButton}" Click="OnTogglePreview" ToolTip="切换 预览 / 原生 (Ctrl+/)"/>
                <Button Content="H1" Style="{StaticResource ToolbarButton}" Click="OnHeading1" ToolTip="一级标题 (Ctrl+1)"/>
                <Button Content="H2" Style="{StaticResource ToolbarButton}" Click="OnHeading2" ToolTip="二级标题 (Ctrl+2)"/>
                <Button Content="B" Style="{StaticResource ToolbarButton}" FontWeight="Bold" Click="OnBold" ToolTip="加粗 (Ctrl+B)"/>
                <Button Content="i" Style="{StaticResource ToolbarButton}" FontStyle="Italic" Click="OnItalic" ToolTip="斜体 (Ctrl+I)"/>
                <Button Content="• 列表" Style="{StaticResource ToolbarButton}" Click="OnList" ToolTip="无序列表 (Ctrl+Shift+7)"/>
                <Button Content="1. 列表" Style="{StaticResource ToolbarButton}" Click="OnOrderedList" ToolTip="有序列表"/>
                <Button Content="引用" Style="{StaticResource ToolbarButton}" Click="OnQuote" ToolTip="引用 (Ctrl+Shift+O)"/>
                <Button Content="代码" Style="{StaticResource ToolbarButton}" Click="OnCode" ToolTip="行内代码 (Ctrl+K)"/>
                <Button Content="代码块" Style="{StaticResource ToolbarButton}" Click="OnCodeBlock" ToolTip="代码块 (Ctrl+Shift+K)"/>
                <Button Content="表格" Style="{StaticResource ToolbarButton}" Click="OnInsertTable" ToolTip="插入表格 (Ctrl+Shift+T)"/>
                <Separator Margin="6,0"/>
                <Button x:Name="SettingsButton" Padding="10,5" Style="{StaticResource ToolbarButton}" Click="OnSettings" ToolTip="设置">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="15"/>
                </Button>
                <ToggleButton x:Name="TopmostButton" Padding="10,5" Style="{StaticResource ToolbarToggleButton}" Click="OnToggleTopmost" ToolTip="窗口置顶(总显示在最前)">
                    <Path Width="15" Height="15" Stretch="Uniform"
                          Data="M 10,2 L 14,2 L 14,4 L 13,5 L 17,11 L 18,11 L 18,13 L 6,13 L 6,11 L 7,11 L 11,5 L 10,4 Z M 12,13 L 12,21"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                          StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Fill="Transparent"/>
                </ToggleButton>
            </WrapPanel>
        </Border>

        <Border x:Name="FindBar" DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Margin="6,4">
                <TextBox x:Name="FindBox" Width="200" VerticalContentAlignment="Center" Padding="4,3"
                         TextChanged="OnFindTextChanged" KeyDown="OnFindKeyDown"/>
                <TextBox x:Name="ReplaceBox" Width="180" Margin="6,0,0,0" VerticalContentAlignment="Center" Padding="4,3"
                         Visibility="Collapsed" KeyDown="OnReplaceKeyDown"/>
                <CheckBox x:Name="CaseBox" Content="Aa" Margin="8,0,0,0" VerticalAlignment="Center" Click="OnFindOptionChanged"/>
                <CheckBox x:Name="WholeWordBox" Content="全词" Margin="6,0,0,0" VerticalAlignment="Center" Click="OnFindOptionChanged"/>
                <CheckBox x:Name="RegexBox" Content=".*" Margin="6,0,0,0" VerticalAlignment="Center" Click="OnFindOptionChanged"/>
                <Button Content="上一个" Style="{StaticResource ToolbarButton}" Click="OnFindPrev"/>
                <Button Content="下一个" Style="{StaticResource ToolbarButton}" Click="OnFindNext"/>
                <Button x:Name="ReplaceButton" Content="替换" Style="{StaticResource ToolbarButton}" Visibility="Collapsed" Click="OnReplace"/>
                <Button x:Name="ReplaceAllButton" Content="全部替换" Style="{StaticResource ToolbarButton}" Visibility="Collapsed" Click="OnReplaceAll"/>
                <TextBlock x:Name="MatchLabel" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#666666"/>
                <Button Content="✕" Style="{StaticResource ToolbarButton}" Click="OnFindClose"/>
            </StackPanel>
        </Border>

        <Grid Background="White">
            <RichTextBox x:Name="Editor"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         FontFamily="Microsoft YaHei UI"
                         FontSize="16"
                         Padding="40,28"
                         BorderThickness="0"
                         Background="White"
                         TextChanged="OnTextChanged"/>

        </Grid>
    </DockPanel>
</Window>
